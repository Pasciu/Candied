<Window x:Class="Candied.Studio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Candied.Studio.Controls"
        xmlns:vm="clr-namespace:Candied.Studio.ViewModels"
        Title="Candied Studio — Universal 16:9 Window Host &amp; Live Vision Workbench"
        Height="860" Width="1540"
        MinHeight="640" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#09090B"
        Foreground="#F4F4F5">

    <Window.Resources>
        <Style x:Key="WorkbenchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Border" Property="BorderBrush" Value="#38BDF8" />
                                <Setter Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.80" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#18181B" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#27272A"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,4,0"
                                CornerRadius="5,5,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#27272A" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38BDF8" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F4F4F5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- ROW 0: TOP WORKBENCH COMMAND BAR                                          -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="14,8">
            <StackPanel>
                <!-- RIGA 1: Brand + Target / Emulatore + Controlli Processo -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border Background="#0284C7" Width="8" Height="22" CornerRadius="3" Margin="0,0,8,0" />
                        <StackPanel>
                            <TextBlock Text="CANDIED STUDIO" FontSize="14" FontWeight="Bold" Foreground="#F4F4F5" />
                            <TextBlock Text="Universal Window Host &amp; Vision" FontSize="10" Foreground="#71717A" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="155" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding RecentTargets}"
                                  SelectedItem="{Binding SelectedRecentTarget}"
                                  DisplayMemberPath="Name"
                                  ToolTip="Seleziona rapidamente un gioco o ROM recente"
                                  Margin="0,0,6,0" Padding="6,4" FontSize="12"
                                  VerticalContentAlignment="Center" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding SelectedTargetPath, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Background="#09090B" Foreground="#D4D4D8" BorderBrush="#3F3F46"
                                 Padding="8,5" VerticalContentAlignment="Center" FontSize="11"
                                 ToolTip="{Binding SelectedTargetPath}" />

                        <Button Grid.Column="2" Content="Sfoglia..." Command="{Binding BrowseTargetCommand}"
                                Style="{StaticResource WorkbenchButtonStyle}"
                                ToolTip="Sfoglia eseguibile PC o file ROM/ISO"
                                Margin="6,0,0,0" Padding="10,5" />

                        <Button Grid.Column="3" Content="Emu..." Command="{Binding BrowseRunnerCommand}"
                                Style="{StaticResource WorkbenchButtonStyle}"
                                ToolTip="{Binding SelectedRunnerPath}"
                                Margin="4,0,0,0" Padding="8,5" />

                        <Button Grid.Column="4" Content="×" Command="{Binding ClearRunnerCommand}"
                                Style="{StaticResource WorkbenchButtonStyle}"
                                Visibility="{Binding HasRunnerPath, Converter={x:Static controls:VisibilityConverters.BooleanToVisibility}}"
                                ToolTip="Rimuovi emulatore/runner selezionato"
                                Margin="4,0,0,0" Padding="7,5" />

                        <Button Grid.Column="5" Content="↻" Command="{Binding RefreshRecentTargetsCommand}"
                                Style="{StaticResource WorkbenchButtonStyle}"
                                ToolTip="Ricarica target recenti"
                                Margin="4,0,0,0" Padding="8,5" />
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="▶ Avvia" Command="{Binding StartCommand}"
                                Style="{StaticResource WorkbenchButtonStyle}"
                                Background="#15803D" BorderBrush="#16A34A"
                                Margin="0,0,5,0" Padding="14,5" />

                        <Button Content="⏹ Stop" Command="{Binding StopCommand}"
                                Style="{StaticResource WorkbenchButtonStyle}"
                                Background="#B91C1C" BorderBrush="#DC2626"
                                Margin="0,0,5,0" Padding="14,5" />

                        <Button Content="↻ Riavvia" Command="{Binding RestartCommand}"
                                Style="{StaticResource WorkbenchButtonStyle}"
                                Background="#B45309" BorderBrush="#D97706"
                                Padding="14,5" />
                    </StackPanel>
                </Grid>

                <!-- RIGA 2: Scala 16:9 + Switch Puntatore + Stato + Toggle Inspector -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Scala 16:9:" Foreground="#A1A1AA" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding ViewportPresets}"
                                  SelectedItem="{Binding SelectedViewportPreset}"
                                  DisplayMemberPath="DisplayName"
                                  Width="240" Padding="6,3" FontSize="11.5"
                                  VerticalContentAlignment="Center" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="{Binding InputIsolationButtonText}"
                            Command="{Binding ToggleInputIsolationCommand}"
                            Style="{StaticResource WorkbenchButtonStyle}"
                            Background="#1E293B" BorderBrush="#38BDF8"
                            Margin="0,0,14,0" Padding="12,4"
                            ToolTip="Isola il puntatore virtuale AI (disponibile con sensore Tier 2)" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding StatusText}"
                               Foreground="#D4D4D8"
                               FontSize="11.5"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,12,0"
                               ToolTip="{Binding StatusText}" />

                    <Button Grid.Column="3"
                            Content="{Binding SidebarToggleButtonText}"
                            Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource WorkbenchButtonStyle}"
                            HorizontalAlignment="Right" Padding="12,4" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1: 16:9 CINEMA STAGE + COLLAPSIBLE WORKBENCH INSPECTOR                -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="480" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="SidebarColumn" Width="485" />
            </Grid.ColumnDefinitions>

            <!-- COLONNA 0: CINEMA STAGE 16:9 -->
            <Grid Grid.Column="0" Background="#09090B">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" x:Name="StageContainer" Margin="14" SizeChanged="OnStageContainerSizeChanged">
                    <Border x:Name="GameBezelBorder"
                            Background="#000000"
                            BorderBrush="#27272A"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <controls:TargetHwndHost x:Name="GameHwndHost"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch" />
                    </Border>
                </Grid>

                <Border Grid.Row="1" Background="#121215" BorderBrush="#27272A" BorderThickness="0,1,0,0" Padding="14,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TargetName}" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" Margin="0,0,10,0" />
                            <TextBlock Text="•" Foreground="#52525B" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding StatusText}" Foreground="#D4D4D8" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding VisionTierBadgeText}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" />
                            </Border>

                            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding ActiveSceneBadge}" Foreground="#E4E4E7" FontSize="11" />
                            </Border>

                            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,6,0">
                                <TextBlock Text="{Binding ViewportResolutionBadge}" Foreground="#A1A1AA" FontSize="11" />
                            </Border>

                            <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="{Binding EmbeddingMode}" Foreground="#4ADE80" FontWeight="SemiBold" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- COLONNA 1: SPLITTER -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="#18181B"
                          Visibility="{Binding IsSidebarVisible, Converter={x:Static controls:VisibilityConverters.BooleanToVisibility}}" />

            <!-- COLONNA 2: WORKBENCH INSPECTOR A 4 TAB -->
            <Border Grid.Column="2"
                    Background="#18181B"
                    BorderBrush="#27272A"
                    BorderThickness="1,0,0,0"
                    Padding="10"
                    Visibility="{Binding IsSidebarVisible, Converter={x:Static controls:VisibilityConverters.BooleanToVisibility}}">

                <TabControl Background="Transparent" BorderThickness="0" Padding="0">

                    <!-- TAB 1: VISION & UI -->
                    <TabItem Header="📸 Vision &amp; UI">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="240" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#27272A" CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding VisionStatusText}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding VisionCapabilitiesText}" Foreground="#A1A1AA" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="📸 Cattura Frame"
                                        Command="{Binding CaptureScreenshotCommand}"
                                        Style="{StaticResource WorkbenchButtonStyle}"
                                        Background="#0284C7" BorderBrush="#38BDF8"
                                        Margin="0,0,4,0" Padding="0,7" />

                                <Button Grid.Column="1" Content="🎯 Rileva Elementi UI"
                                        Command="{Binding InspectUiElementsCommand}"
                                        Style="{StaticResource WorkbenchButtonStyle}"
                                        Background="#0D9488" BorderBrush="#14B8A6"
                                        Margin="4,0,0,0" Padding="0,7" />
                            </Grid>

                            <Border Grid.Row="2"
                                    Background="#09090B"
                                    BorderBrush="#3F3F46"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    ClipToBounds="True">
                                <Grid x:Name="ScreenshotViewerContainer"
                                      Background="Transparent"
                                      Cursor="Cross"
                                      MouseMove="OnScreenshotImageMouseMove"
                                      MouseLeftButtonDown="OnScreenshotImageMouseDown">

                                    <Image x:Name="ScreenshotPreviewImage"
                                           Source="{Binding ScreenshotImage}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />

                                    <TextBlock Text="Nessun frame catturato.&#x0a;Premi 'Cattura Frame' (funziona sia in Tier 1 Win32 che in Tier 2 Sensor)."
                                               TextAlignment="Center"
                                               Foreground="#71717A"
                                               FontSize="11.5"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasScreenshot, Converter={x:Static controls:VisibilityConverters.InvertedBooleanToVisibility}}" />

                                    <Border Background="#B91C1C" Padding="6,2" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0"
                                            CornerRadius="3" Visibility="{Binding IsUniformImage, Converter={x:Static controls:VisibilityConverters.BooleanToVisibility}}">
                                        <TextBlock Text="ATTENZIONE: Frame uniforme rilevato" FontSize="10" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="3" Margin="0,6,0,8">
                                <Border Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="{Binding HoverCoordinatesText}"
                                               Foreground="#38BDF8"
                                               FontFamily="Consolas"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>

                                <CheckBox IsChecked="{Binding SendClickOnImageTap}"
                                          Foreground="#D4D4D8"
                                          FontSize="11.5"
                                          Margin="2,6,0,0"
                                          Content="Cliccando sull'anteprima invia un click al gioco/emulatore" />
                            </StackPanel>

                            <Grid Grid.Row="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="150" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding UiInspectionSummary}" Foreground="#4ADE80" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding UiSearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                             Background="#09090B" Foreground="#F4F4F5" BorderBrush="#3F3F46"
                                             Padding="6,3" FontSize="11"
                                             ToolTip="Filtra elementi UI per testo o ID" />
                                </Grid>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding UiElementItems}"
                                         Background="#09090B"
                                         BorderBrush="#27272A"
                                         BorderThickness="1"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:UiElementItemViewModel}">
                                            <Border Background="#18181B" CornerRadius="4" Padding="8,5" Margin="0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding DisplayLabel}" Foreground="#F4F4F5" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding Type}" Foreground="#38BDF8" FontSize="10.5" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding CoordinatesSummary}" Foreground="#A1A1AA" FontFamily="Consolas" FontSize="10.5" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding Ref1080Summary}" Foreground="#4ADE80" FontFamily="Consolas" FontSize="10.5" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="Clicca"
                                                            Command="{Binding DataContext.ClickUiElementCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource WorkbenchButtonStyle}"
                                                            Padding="8,3" FontSize="11" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 2: SCENA & NODI -->
                    <TabItem Header="🔍 Scena &amp; Nodi">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="115" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding SceneFilterText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#09090B" Foreground="#F4F4F5" BorderBrush="#3F3F46"
                                         Padding="8,6" FontSize="12" VerticalContentAlignment="Center"
                                         ToolTip="Filtra nodi scena per nome o percorso" />

                                <Button Grid.Column="1"
                                        Content="🔍 Ispeziona Scena"
                                        Command="{Binding InspectSceneCommand}"
                                        Style="{StaticResource WorkbenchButtonStyle}"
                                        Background="#0284C7" BorderBrush="#38BDF8"
                                        Margin="6,0,0,0" Padding="12,6" />
                            </Grid>

                            <TextBlock Grid.Row="1" Text="{Binding SceneSummaryText}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,6" />

                            <Border Grid.Row="2" Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="6" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="TELECAMERE ATTIVE" Foreground="#A1A1AA" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,4" />
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding SceneCameras}"
                                             Background="Transparent" BorderThickness="0"
                                             HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SceneCameraItemViewModel}">
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#F4F4F5" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ProjectionSummary}" Foreground="#38BDF8" FontFamily="Consolas" FontSize="10.5" Margin="8,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding DepthSummary}" Foreground="#4ADE80" FontFamily="Consolas" FontSize="10.5" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Border Grid.Row="3" Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="NODI SCENA ATTIVI" Foreground="#A1A1AA" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,4" />
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding SceneNodes}"
                                             Background="Transparent" BorderThickness="0"
                                             HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SceneNodeItemViewModel}">
                                                <Border Background="#18181B" CornerRadius="4" Padding="8,5" Margin="0,2">
                                                    <StackPanel>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding HierarchyDisplay}" Foreground="#F4F4F5" FontWeight="SemiBold" FontSize="11.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding HierarchyDisplay}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding NodeType}" Foreground="#38BDF8" FontSize="10.5" FontWeight="SemiBold" Margin="6,0,0,0" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding ComponentsSummary}" Foreground="#4ADE80" FontFamily="Consolas" FontSize="10.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding BoundsSummary}" Foreground="#A1A1AA" FontFamily="Consolas" FontSize="10.5" />
                                                        <TextBlock Text="{Binding AttributesSummary}" Foreground="#71717A" FontSize="10" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- TAB 3: COMANDI & INPUT 3-CHANNEL -->
                    <TabItem Header="🎮 Comandi">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 1. Riepilogo Profilo Comandi + Reload -->
                            <Border Grid.Row="0" Background="#27272A" CornerRadius="6" Padding="10,7" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ControlsSummaryText}" Foreground="#38BDF8" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button Grid.Column="1" Content="↻ Ricarica" Command="{Binding ReloadControlsCommand}"
                                            Style="{StaticResource WorkbenchButtonStyle}" Padding="8,4" FontSize="11" Margin="8,0,0,0" />
                                </Grid>
                            </Border>

                            <!-- 2. Pad Rapido Azioni Semantiche -->
                            <Border Grid.Row="1" Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="PAD AZIONI SEMANTICHE RAPIDE" Foreground="#A1A1AA" FontSize="10.5" FontWeight="Bold" Margin="0,0,0,6" />
                                    <UniformGrid Columns="4" Margin="0,0,0,4">
                                        <Button Content="▲ Su" Command="{Binding TriggerActionCommand}" CommandParameter="MoveUp" Style="{StaticResource WorkbenchButtonStyle}" Margin="2" Padding="6,5" />
                                        <Button Content="▼ Giù" Command="{Binding TriggerActionCommand}" CommandParameter="MoveDown" Style="{StaticResource WorkbenchButtonStyle}" Margin="2" Padding="6,5" />
                                        <Button Content="◀ Sx" Command="{Binding TriggerActionCommand}" CommandParameter="MoveLeft" Style="{StaticResource WorkbenchButtonStyle}" Margin="2" Padding="6,5" />
                                        <Button Content="▶ Dx" Command="{Binding TriggerActionCommand}" CommandParameter="MoveRight" Style="{StaticResource WorkbenchButtonStyle}" Margin="2" Padding="6,5" />
                                    </UniformGrid>
                                    <UniformGrid Columns="3">
                                        <Button Content="✔ Confirm" Command="{Binding TriggerActionCommand}" CommandParameter="Confirm" Style="{StaticResource WorkbenchButtonStyle}" Background="#15803D" BorderBrush="#16A34A" Margin="2" Padding="6,5" />
                                        <Button Content="✖ Cancel" Command="{Binding TriggerActionCommand}" CommandParameter="Cancel" Style="{StaticResource WorkbenchButtonStyle}" Background="#B91C1C" BorderBrush="#DC2626" Margin="2" Padding="6,5" />
                                        <Button Content="⏸ Pause" Command="{Binding TriggerActionCommand}" CommandParameter="Pause" Style="{StaticResource WorkbenchButtonStyle}" Margin="2" Padding="6,5" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- 3. Invio Tasto Diretto -->
                            <Grid Grid.Row="2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tasto:" Foreground="#A1A1AA" VerticalAlignment="Center" FontSize="11.5" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" Text="{Binding CustomKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#09090B" Foreground="#F4F4F5" BorderBrush="#3F3F46"
                                         Padding="8,5" FontSize="11.5" VerticalContentAlignment="Center"
                                         ToolTip="Es: Enter, Escape, Space, Tab, F1, E, I, UpArrow" />
                                <Button Grid.Column="2" Content="Invia Tasto" Command="{Binding SendCustomKeyCommand}"
                                        Style="{StaticResource WorkbenchButtonStyle}" Background="#0284C7" BorderBrush="#38BDF8"
                                        Margin="6,0,0,0" Padding="10,5" />
                            </Grid>

                            <!-- 4. Azioni Mappate in controls.json -->
                            <ListBox Grid.Row="3"
                                     ItemsSource="{Binding ControlActions}"
                                     Background="#09090B" BorderBrush="#27272A" BorderThickness="1"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ControlActionItemViewModel}">
                                        <Border Background="#18181B" CornerRadius="4" Padding="8,5" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#F4F4F5" FontWeight="SemiBold" FontSize="11.5" />
                                                        <TextBlock Text="{Binding Source}" Foreground="#4ADE80" FontSize="10" Margin="8,1,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding BindingsSummary}" Foreground="#A1A1AA" FontFamily="Consolas" FontSize="10.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Esegui"
                                                        Command="{Binding DataContext.TriggerActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding ActionName}"
                                                        Style="{StaticResource WorkbenchButtonStyle}"
                                                        Padding="8,3" FontSize="11" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- TAB 4: CONSOLE LOG -->
                    <TabItem Header="📜 Log">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding LogSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#09090B" Foreground="#F4F4F5" BorderBrush="#3F3F46"
                                         Padding="8,5" FontSize="11.5" VerticalContentAlignment="Center"
                                         ToolTip="Cerca nei log Runtime / SensorBridge / Host" />

                                <Button Grid.Column="1" Content="Copia" Command="{Binding CopyLogsCommand}"
                                        Style="{StaticResource WorkbenchButtonStyle}"
                                        Margin="6,0,0,0" Padding="10,4" FontSize="11" />

                                <Button Grid.Column="2" Content="Pulisci" Command="{Binding ClearLogsCommand}"
                                        Style="{StaticResource WorkbenchButtonStyle}"
                                        Margin="4,0,0,0" Padding="10,4" FontSize="11" />
                            </Grid>

                            <CheckBox Grid.Row="1"
                                      IsChecked="{Binding OnlyWarningsAndErrors}"
                                      Content="Mostra solo Warning ed Errori ([Warning], [Error], Exception)"
                                      Foreground="#D4D4D8" FontSize="11.5" Margin="2,0,0,6" />

                            <ListBox Grid.Row="2"
                                     x:Name="LogsList"
                                     ItemsSource="{Binding FilteredLogEntries}"
                                     Background="#09090B"
                                     BorderBrush="#27272A"
                                     BorderThickness="1"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4,1" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:StudioLogEntry}">
                                        <TextBlock Text="{Binding FullText}" Foreground="{Binding ForegroundHex}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
